# Copy to `.env` and adjust as needed. All of these have sane defaults in app/config.py.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0.4

WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

INDIC_PARLER_MODEL=ai4bharat/indic-parler-tts
# Optional Piper voices for French/German (download .onnx files, see ml/README.md)
PIPER_VOICE_FR=
PIPER_VOICE_DE=

ENABLE_TTS=true
ENABLE_STT=true

DATABASE_URL=sqlite:///./app/data/musemate.db
CORS_ORIGINS=http://localhost:5173
DEVICE_ID_DEFAULT=CONSOLE-01

# ── ESP32 serial bridge ───────────────────────────────────────────────────
# Leave RFID_COM_PORT blank to auto-detect the first CP210x (Silicon Labs)
# USB-UART adapter.  Set it explicitly when multiple CP210x devices are
# plugged in (e.g. COM5 on Windows).
RFID_COM_PORT=
RFID_BAUD=115200
